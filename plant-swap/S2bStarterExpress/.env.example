# Copy this file to .env and fill in your own values. Never commit .env.

# Your Atlas connection string. The DATABASE NAME is the part after the host
# and before the "?" (here: sketchGallery). Change it to your own name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sketchGallery?retryWrites=true&w=majority

# The port this server listens on.
PORT=3001
